# Local environment and secrets
.env
.env.*
!.env.example
backend/config/demo_users.yaml
backend/config/demo-accounts/accounts.private.md
# Production and operator-selected private Markdown account catalogs.
*.private.md
*.pem
*.key

# JavaScript dependencies and build output
node_modules/
.pnpm-store/
.next/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/.turbo/
*.tsbuildinfo

# Python environments and caches
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime data must stay outside Git
data/
backend/data/
# reset_demo_runtime.py renames the live runtime instead of deleting it; those
# quarantined copies hold the same private SQLite, snapshots and group files.
data.quarantine-*/
backend/data.quarantine-*/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
*.log

# OS/editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local Docker/coverage artifacts
docker-compose.override.yml
htmlcov/
backend/config/provider-policies/

# Locally reconstructed stage media; never commit generated assets.
frontend/public/stage/*.ply
frontend/public/stage/*.sog
frontend/public/stage/*.spz
frontend/public/stage/courtyard-depth-color.png
frontend/public/stage/courtyard-depth-map.png
frontend/public/stage/courtyard-equirect.png
frontend/public/stage/courtyard-equirect-depth.png
frontend/public/stage/courtyard-equirect-depth.json
