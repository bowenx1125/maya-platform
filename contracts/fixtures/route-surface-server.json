{
  "openapi": "3.1.0",
  "info": {
    "title": "Maya Teaching Platform API",
    "version": "0.1.0-g0.4",
    "description": "Demo v0.1 platform contract. Provider names, model names, external voice IDs, API keys, absolute file paths, and prepared turn text are never public fields."
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created and CSRF token returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "description": "FastAPI request validation response (explicitly allow-listed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/switch": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "switchDemoIdentity",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "description": "Available only when DEMO_MODE=true; rotates the server session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id"
                ],
                "properties": {
                  "user_id": {
                    "$ref": "#/components/schemas/Uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "description": "FastAPI request validation response (explicitly allow-listed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/demo-identities": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "listDemoIdentities",
        "description": "Requires an existing session and DEMO_MODE=true; never returns passwords.",
        "responses": {
          "200": {
            "description": "Safe identity options.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "user_id",
                      "display_name",
                      "role"
                    ],
                    "properties": {
                      "user_id": {
                        "$ref": "#/components/schemas/Uuid"
                      },
                      "display_name": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "teacher",
                          "student"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Current user, memberships, refreshed CSRF token and session expiry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "logout",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked."
          },
          "422": {
            "description": "FastAPI request validation response (explicitly allow-listed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses": {
      "get": {
        "tags": [
          "Organization"
        ],
        "operationId": "listCourses",
        "responses": {
          "200": {
            "description": "Courses visible to current user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Course"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses/{course_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CourseId"
        }
      ],
      "get": {
        "tags": [
          "Organization"
        ],
        "operationId": "getCourse",
        "responses": {
          "200": {
            "description": "Course detail and read-only members.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "description": "FastAPI request validation response (explicitly allow-listed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses/{course_id}/groups": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CourseId"
        }
      ],
      "get": {
        "tags": [
          "Organization"
        ],
        "operationId": "listCourseGroups",
        "responses": {
          "200": {
            "description": "Seeded groups visible in this course.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Group"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "description": "FastAPI request validation response (explicitly allow-listed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/groups/{group_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/GroupId"
        }
      ],
      "get": {
        "tags": [
          "Organization"
        ],
        "operationId": "getGroup",
        "responses": {
          "200": {
            "description": "Group and read-only members.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "description": "FastAPI request validation response (explicitly allow-listed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Ready"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "maya_session"
      }
    },
    "parameters": {
      "CourseId": {
        "name": "course_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "GroupId": {
        "name": "group_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "AgentId": {
        "name": "agent_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "VersionId": {
        "name": "version_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "SnapshotId": {
        "name": "snapshot_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "SnapshotDocumentId": {
        "name": "snapshot_document_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "DocumentId": {
        "name": "document_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "VoiceProfileId": {
        "name": "voice_profile_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "DebateId": {
        "name": "debate_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "TurnId": {
        "name": "turn_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "RevisionId": {
        "name": "revision_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "AccessToken": {
        "name": "access_token",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 32
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16
        }
      },
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "description": "Raw per-session CSRF token returned by AuthSession; required on authenticated mutations.",
        "schema": {
          "type": "string",
          "minLength": 32
        }
      }
    },
    "requestBodies": {
      "ControlCommand": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "expected_control_version"
              ],
              "properties": {
                "expected_control_version": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Stable platform error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PlaybackState": {
        "description": "Authoritative playback state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PlaybackState"
            }
          }
        }
      }
    },
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid"
      },
      "IsoTime": {
        "type": "string",
        "format": "date-time"
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "request_id": {
            "$ref": "#/components/schemas/Uuid"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": [
          "user",
          "csrf_token",
          "expires_at"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          },
          "csrf_token": {
            "type": "string",
            "minLength": 32
          },
          "expires_at": {
            "$ref": "#/components/schemas/IsoTime"
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "courses",
          "groups"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseMembership"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupMembership"
            }
          }
        }
      },
      "CourseMembership": {
        "type": "object",
        "required": [
          "course_id",
          "role"
        ],
        "properties": {
          "course_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher",
              "student"
            ]
          }
        }
      },
      "GroupMembership": {
        "type": "object",
        "required": [
          "group_id",
          "role"
        ],
        "properties": {
          "group_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "leader",
              "admin",
              "member"
            ]
          }
        }
      },
      "Course": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "current_audio_debate_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CourseDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Course"
          },
          {
            "type": "object",
            "properties": {
              "members": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          }
        ]
      },
      "Group": {
        "type": "object",
        "required": [
          "id",
          "course_id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "course_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GroupDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Group"
          },
          {
            "type": "object",
            "properties": {
              "members": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          }
        ]
      },
      "Member": {
        "type": "object",
        "required": [
          "user_id",
          "display_name",
          "role"
        ],
        "properties": {
          "user_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "KnowledgeDocument": {
        "type": "object",
        "required": [
          "id",
          "group_id",
          "source_filename",
          "char_count",
          "index_status",
          "workspace_state",
          "created_at"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "group_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "source_filename": {
            "type": "string"
          },
          "char_count": {
            "type": "integer",
            "minimum": 1
          },
          "index_status": {
            "type": "string",
            "enum": [
              "pending",
              "indexing",
              "ready",
              "failed"
            ]
          },
          "workspace_state": {
            "type": "string",
            "enum": [
              "active",
              "hidden"
            ]
          },
          "safe_error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "$ref": "#/components/schemas/IsoTime"
          }
        }
      },
      "SnapshotDocument": {
        "type": "object",
        "required": [
          "id",
          "source_filename",
          "char_count",
          "order_index"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "source_filename": {
            "type": "string"
          },
          "char_count": {
            "type": "integer",
            "minimum": 1
          },
          "order_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "KnowledgeSnapshot": {
        "type": "object",
        "required": [
          "id",
          "agent_version_id",
          "content_hash",
          "total_char_count",
          "documents",
          "created_at"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "agent_version_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "content_hash": {
            "type": "string"
          },
          "total_char_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SnapshotDocument"
            }
          },
          "created_at": {
            "$ref": "#/components/schemas/IsoTime"
          }
        }
      },
      "KnowledgeDocumentMutation": {
        "type": "object",
        "required": [
          "document",
          "agent_version"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/KnowledgeDocument"
          },
          "agent_version": {
            "$ref": "#/components/schemas/AgentVersion"
          }
        }
      },
      "AgentSummary": {
        "type": "object",
        "required": [
          "id",
          "group_id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "group_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "current_published_version_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "current_draft_version_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AgentDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AgentSummary"
          },
          {
            "type": "object",
            "properties": {
              "versions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AgentVersion"
                }
              }
            }
          }
        ]
      },
      "AgentVersion": {
        "type": "object",
        "required": [
          "id",
          "agent_id",
          "version_label",
          "state",
          "revision",
          "avatar_config",
          "voice_fallback_active"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "agent_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "version_label": {
            "type": "string",
            "pattern": "^V[0-9]+\\.[0-9]+$"
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "superseded"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "agent_md": {
            "type": "string",
            "maxLength": 12000
          },
          "avatar_config": {
            "$ref": "#/components/schemas/AvatarConfig"
          },
          "voice_profile_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_voice_profile_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "voice_fallback_active": {
            "type": "boolean"
          },
          "knowledge_snapshot_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "enabled_documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KnowledgeDocument"
            }
          },
          "publish_blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateAgentDraftRequest": {
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "agent_md": {
            "type": "string",
            "maxLength": 12000
          },
          "avatar_config": {
