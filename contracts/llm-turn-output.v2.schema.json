{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maya://schemas/llm_turn_output_v2",
  "title": "LLMTurnOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["segments"],
  "properties": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_ids", "reply_to"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "source_ids": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^S[1-9][0-9]*$"
            }
          },
          "reply_to": {
            "type": ["string", "null"],
            "pattern": "^B[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
