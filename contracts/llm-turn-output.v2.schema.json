{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maya://schemas/llm_turn_output_v2",
  "title": "LLMTurnOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["segments"],
  "properties": {
    "question": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["target_agent_id", "text"],
      "properties": {
        "target_agent_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "discussion_memory": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "position",
        "change",
        "reason",
        "influence",
        "unresolved_question"
      ],
      "properties": {
        "position": { "type": "string", "minLength": 1, "maxLength": 400 },
        "change": {
          "type": "string",
          "enum": ["retained", "qualified", "revised"]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "influence": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["agent_id", "point"],
          "properties": {
            "agent_id": { "type": "string", "minLength": 1 },
            "point": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        },
        "unresolved_question": { "type": "string", "maxLength": 400 }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_ids", "reply_to"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^S[1-9][0-9]*$"
            }
          },
          "reply_to": {
            "type": ["string", "null"],
            "pattern": "^B[1-9][0-9]*$"
          },
          "support_mode": {
            "type": "string",
            "enum": ["direct", "contextual", "no_match"]
          }
        }
      }
    }
  }
}
