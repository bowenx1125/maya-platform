# Copy to .env for local use. Never commit .env.
NODE_ENV=development
DEMO_MODE=true
DEMO_QUICK_LOGIN=true
SESSION_SECRET=replace-with-at-least-32-random-characters
CLASSROOM_PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=sqlite:////app/data/maya.sqlite3
DATA_ROOT=/app/data
DEMO_USERS_FILE=/app/config/demo_users.yaml
DEMO_ACCOUNTS_FILE=/app/config/demo-accounts/accounts.private.md
ALLOW_LEGACY_DEMO_USERS=false
MAYA_ENV=development

# Keep all automated and ordinary Demo work Mock-only until a separate real-provider Gate.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
TTS_PROVIDER=mock
VOICE_PROVIDER=mock
TRANSLATION_PROVIDER=mock

# Optional real-provider values stay local and blank by default.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DEEPL_API_KEY=
FALLBACK_VOICE_PROFILE_ID=

NEXT_PUBLIC_RUNTIME_MODE=container
NEXT_PUBLIC_BUILD_SHA=local
