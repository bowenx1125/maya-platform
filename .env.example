# Copy this file to .env for local use. Keep all values local and uncommitted.
NODE_ENV=
DEMO_MODE=
DEMO_QUICK_LOGIN=
# Standing consent for the provider data-call disclosure. Only has effect
# while DEMO_MODE is true; leave empty so a person confirms each one.
DEMO_AUTO_CONFIRM_PROVIDER=
# The deployment operator's one-time consent for a classroom or production
# instance. Each exact manifest is still confirmed and recorded in the ledger;
# teachers and students never see a disclosure screen. Leave empty to require
# a teacher confirmation instead.
PROVIDER_STANDING_CONSENT=
SESSION_SECRET=
# Cookie and database session lifetime; applies to new sign-ins.
SESSION_TTL_DAYS=30
CLASSROOM_PUBLIC_BASE_URL=
DATABASE_URL=
# PostgreSQL only (SQLite support was removed). Empty in Compose means the
# bundled postgres service; set it for a backend run outside Compose.
# BACKEND_REPLICAS is the production compose replica count.
# Unified admission queue: login, create, write and LLM calls all wait in one
# per-process queue sized by server pressure (AIMD on 1m loadavg, MemAvailable,
# DB write p95, DB pool wait p95, thread-pool use). Weights llm 4, create 3,
# write 2, login 1; reads
# bypass. Danger line: load >= HOST_LOAD_REJECT_THRESHOLD (6.0) or MemAvailable
# < MEMORY_GUARD_MIN_AVAILABLE_MB (500) admits nothing new; requests suspend and
# resume once load <= HOST_LOAD_RESUME_THRESHOLD (4.0) AND MemAvailable >=
# MEMORY_GUARD_RESUME_AVAILABLE_MB (550). ADAPTIVE_ADMISSION_MAX_IN_FLIGHT (48) is
# the single global hard cap. Budget: ADAPTIVE_ADMISSION_MAX_UNITS (128 = 20
# Chat/Team turns x 6 + logins/creates) and MIN 4; it starts at ADAPTIVE_ADMISSION_INITIAL_UNITS (72).
# Every 2s it shrinks x0.7 on danger, load >= 4, Mem < 900 MiB
# (ADAPTIVE_ADMISSION_SOFT_*), or a 30s DB write / pool wait p95 > 500 ms (20+
# samples); holds at load 3-4, Mem 900-1100 MiB or thread pool >= 90%
# (ADAPTIVE_ADMISSION_HOLD_*); otherwise grows +4 below half of max, else +2.
# 30s idle and healthy returns it to at least the initial budget. A fast brake
# runs every 1s sample: a 10s DB write p95 >= 800 ms, pool-wait p95 >= 250 ms,
# >= 10 write statements running, or host CPU >= 95% for 3 samples halves the
# budget (once per 5s) and clamps it to what is in flight
# (ADAPTIVE_ADMISSION_BRAKE_*; 0 disables a signal). Queue 200 (beyond it an immediate 503), total
# wait 180s; on timeout or a full queue a retryable
# adaptive_admission_busy 503. ADAPTIVE_ADMISSION_ENABLED=false freezes the
# budget at max (pressure queueing still applies). LLM_ADMISSION_* (8),
# WRITE_GUARD_* (8 turns) and CREATE_ADMISSION_* (8) are per-operation backstops
# (#140 sweep; 0 disables one);
# they wait only for what is left of the same 180s budget (create's own wait
# is also 180s). AUTH_LOGIN_ADMISSION_* is removed (login joins the queue).
# Request p95 (last 60s of /api, without LLM work and SSE) is shown on
# /health/admission only: it includes queue time, so it never sizes the budget.
# Each budget change logs one "adaptive_budget" line with its reason. AUTH_HASH_CONCURRENCY (2) caps parallel
# Argon2 hash/verify calls per process (each allocates 64 MiB): 2 replicas x 2
# x 64 MiB = 256 MiB for hashing; waits share the same 180s budget.
# Each Chat/Team message logs one line: grep '"event":"message_timing"'
# (queue wait, model calls, DB write ms, total); /health/admission (internal
# port) shows the 15-minute p50/p95 under message_timing.
ADAPTIVE_ADMISSION_ENABLED=true
# Busy/pressure 503s are retryable; the UI keeps the typed message / form input.
DATA_ROOT=
DEMO_USERS_FILE=
DEMO_ACCOUNTS_FILE=
ALLOW_LEGACY_DEMO_USERS=
MAYA_ENV=
LLM_PROVIDER=
MAYA_REPORT_PROVIDER=
EMBEDDING_PROVIDER=
TTS_PROVIDER=
VOICE_PROVIDER=
DASHSCOPE_API_KEY=
# Optional second key for Chatform only: every Agent and Team chat model call
# and the RAG retrieval those chats make (formal assessment turns included).
# Empty means chats use DASHSCOPE_API_KEY. Voices/TTS, Agent and Knowledge
# embeddings, Knowledge generation, Debates and reports always use
# DASHSCOPE_API_KEY. Both keys must belong to DASHSCOPE_WORKSPACE_ID.
DASHSCOPE_CHAT_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=
# Rotate the key by replacing DASHSCOPE_API_KEY and restarting the backend.
# Keep the workspace id, region, and SESSION_SECRET. Cloned voices belong to
# the workspace, not the key. See docs/REAL_PROVIDER_SETUP.md.
EMBEDDING_PROVIDER_POLICY_HASH=
LLM_PROVIDER_POLICY_HASH=
REPORT_PROVIDER_POLICY_HASH=
PROVIDER_POLICY_HASH=
# Chat, debate and report share this id. Change it to switch models.
LLM_MODEL=qwen3.8-max-2026-09-02
DEEPL_API_KEY=
FALLBACK_VOICE_PROFILE_ID=
# Clone model for new voices: qwen-audio-3.1-tts-flash (default) or
# qwen-audio-3.0-tts-flash. System voices always use qwen3-tts-flash.
VOICE_CLONE_MODEL=
# Optional voices for immutable baseline characters. Omit a name to use
# FALLBACK_VOICE_PROFILE_ID. Example: socrates=<uuid>,laozi=<uuid>
BASELINE_DEFAULT_VOICES=
# Debate generation defaults. The Debate form's parameter card starts from
# these and can override them for one Debate; the values are frozen into the
# Debate when it is created. An empty value means "do not send". Unset, each
# matches what Debates ran with before these existed.
#   DEBATE_LLM_MODEL           empty = LLM_MODEL (qwen3.8-max-2026-09-02)
#   DEBATE_LLM_TEMPERATURE     0.65; 0 <= t < 2
#   DEBATE_LLM_TOP_P           0.8; 0 < p <= 1
#   DEBATE_LLM_PRESENCE_PENALTY empty; -2..2
#   DEBATE_LLM_FREQUENCY_PENALTY empty; -2..2, stored but never sent
#                              (DashScope does not document it)
#   DEBATE_LLM_REPETITION_PENALTY empty; 0 < r <= 2, 1.0 = no penalty
#   DEBATE_LLM_MAX_TOKENS      empty; 1..32768 (may cut the JSON short)
#   DEBATE_LLM_ENABLE_THINKING false
#   DEBATE_LLM_SEED            empty; 0..2147483647
#   DEBATE_LLM_TIMEOUT_SECONDS 120; 0 < s <= 600
#   DEBATE_TTS_MODEL           empty = VOICE_CLONE_MODEL; a supported speech model
#   DEBATE_TTS_ENGINE          qwen3 (default) or cosyvoice; cosyvoice streams
#                              word timestamps to the 3D performance compiler
#   DEBATE_TTS_COSYVOICE_VOICE longanyang; cosyvoice system voice for agents
#                              whose voice id is not a cosyvoice voice
#   DEBATE_TTS_FALLBACK        false; degrade cosyvoice back to qwen3 on
#                              pre-request refusals only (never after a charge)
#   DEBATE_TTS_RATE            1.25; 0.5..2.0 speaking rate (1.0 normal); cloned voices only
#   DEBATE_TTS_INSTRUCTION     empty; one sentence on tone/emotion/role; cloned voices only
#   DEBATE_TTS_SEED            empty; 0..65535, steadies the voice, not byte-identical; cloned only
# Debates always play at 1.0: the speaking rate comes from DEBATE_TTS_RATE.
DEBATE_LLM_MODEL=
DEBATE_LLM_TEMPERATURE=0.65
DEBATE_LLM_TOP_P=0.8
DEBATE_LLM_PRESENCE_PENALTY=
DEBATE_LLM_FREQUENCY_PENALTY=
DEBATE_LLM_REPETITION_PENALTY=
DEBATE_LLM_MAX_TOKENS=
DEBATE_LLM_ENABLE_THINKING=false
DEBATE_LLM_SEED=
DEBATE_LLM_TIMEOUT_SECONDS=120
DEBATE_TTS_MODEL=
DEBATE_TTS_ENGINE=qwen3
DEBATE_TTS_COSYVOICE_VOICE=longanyang
DEBATE_TTS_FALLBACK=false
DEBATE_TTS_RATE=1.25
DEBATE_TTS_INSTRUCTION=
DEBATE_TTS_SEED=
NEXT_PUBLIC_RUNTIME_MODE=
NEXT_PUBLIC_BUILD_SHA=

# Debates (beta) only. With this off, classroom interaction opens after the
# debate finishes, exactly as the classic Debates surface has always required.
# With it on, a teacher can open it while the debate is running, which is what
# puts the join code on the 3D stage and flies messages across it. It also
# means the vote is a running tally rather than a verdict taken once everyone
# has spoken — say so when you report the numbers.
DEBATES_BETA_LIVE_INTERACTION=false

# Debate speeches are also served as MP3 (ffmpeg in the backend image, cached in
# memory, about a tenth of the WAV size). Production Compose turns it on; WAV
# stays available either way.
DEBATE_AUDIO_MP3=false
# Server size: CPU-bound capacity defaults grow by cores / baseline (never below 1x).
CAPACITY_BASELINE_CPUS=2
CAPACITY_SCALE=
