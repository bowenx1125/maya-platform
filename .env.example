# Copy this file to .env for local use. Keep all values local and uncommitted.
NODE_ENV=
DEMO_MODE=
DEMO_QUICK_LOGIN=
# Standing consent for the provider data-call disclosure. Only has effect
# while DEMO_MODE is true; leave empty so a person confirms each one.
DEMO_AUTO_CONFIRM_PROVIDER=
# The deployment operator's one-time consent for a classroom or production
# instance. Each exact manifest is still confirmed and recorded in the ledger;
# teachers and students never see a disclosure screen. Leave empty to require
# a teacher confirmation instead.
PROVIDER_STANDING_CONSENT=
SESSION_SECRET=
CLASSROOM_PUBLIC_BASE_URL=
DATABASE_URL=
# Production uses PostgreSQL. Leave this empty locally to keep SQLite.
# MAYA_POSTGRES_IMPORT_SOURCE is a read-only SQLite snapshot copied once into
# an empty PostgreSQL database. MAYA_POSTGRES_ALLOW_EMPTY=true skips that copy.
# BACKEND_REPLICAS is the production compose replica count.
# Unified admission queue: login, create, write and LLM calls all wait in one
# per-process queue sized by server pressure (AIMD on 1m loadavg, MemAvailable,
# DB write p95, DB pool wait p95, thread-pool use). Weights llm 4, create 3,
# write 2, login 1; reads
# bypass. Danger line: load >= HOST_LOAD_REJECT_THRESHOLD (6.0) or MemAvailable
# < MEMORY_GUARD_MIN_AVAILABLE_MB (500) admits nothing new; requests suspend and
# resume once load <= HOST_LOAD_RESUME_THRESHOLD (4.0) AND MemAvailable >=
# MEMORY_GUARD_RESUME_AVAILABLE_MB (550). ADAPTIVE_ADMISSION_MAX_IN_FLIGHT (32) is
# the single global hard cap. Budget: ADAPTIVE_ADMISSION_MAX_UNITS (96 = 20 LLM
# x 4 + 16) and MIN 4; it starts at ADAPTIVE_ADMISSION_INITIAL_UNITS (72).
# Every 2s it shrinks x0.7 on danger, load >= 4, Mem < 900 MiB
# (ADAPTIVE_ADMISSION_SOFT_*), or a 30s DB write / pool wait p95 > 500 ms (20+
# samples); holds at load 3-4, Mem 900-1100 MiB or thread pool >= 90%
# (ADAPTIVE_ADMISSION_HOLD_*); otherwise grows +4 below half of max, else +2.
# 30s idle and healthy returns it to at least the initial budget. Queue 200 (beyond it an immediate 503), total
# wait 180s; on timeout or a full queue a retryable
# adaptive_admission_busy 503. ADAPTIVE_ADMISSION_ENABLED=false freezes the
# budget at max (pressure queueing still applies). LLM_ADMISSION_* (20),
# WRITE_GUARD_* (12) and CREATE_ADMISSION_* (4) remain per-operation backstops;
# they wait only for what is left of the same 180s budget (create's own wait
# is also 180s). AUTH_LOGIN_ADMISSION_* is removed (login joins the queue).
# Request p95 (last 60s of /api, without LLM work and SSE) is shown on
# /health/admission only: it includes queue time, so it never sizes the budget.
# Each budget change logs one "adaptive_budget" line with its reason. AUTH_HASH_CONCURRENCY (3) caps parallel
# Argon2 hash/verify calls per process (each allocates 64 MiB): 2 replicas x 3
# x 64 MiB = 384 MiB worst case; waits share the same 180s budget.
# Each Chat/Team message logs one line: grep '"event":"message_timing"'
# (queue wait, model calls, DB write ms, total); /health/admission (internal
# port) shows the 15-minute p50/p95 under message_timing.
ADAPTIVE_ADMISSION_ENABLED=true
# Busy/pressure 503s are retryable; the UI keeps the typed message / form input.
DATA_ROOT=
DEMO_USERS_FILE=
DEMO_ACCOUNTS_FILE=
ALLOW_LEGACY_DEMO_USERS=
MAYA_ENV=
LLM_PROVIDER=
MAYA_REPORT_PROVIDER=
EMBEDDING_PROVIDER=
TTS_PROVIDER=
VOICE_PROVIDER=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=
# Rotate the key by replacing DASHSCOPE_API_KEY and restarting the backend.
# Keep the workspace id, region, and SESSION_SECRET. Cloned voices belong to
# the workspace, not the key. See docs/REAL_PROVIDER_SETUP.md.
EMBEDDING_PROVIDER_POLICY_HASH=
LLM_PROVIDER_POLICY_HASH=
REPORT_PROVIDER_POLICY_HASH=
PROVIDER_POLICY_HASH=
# Chat, debate and report share this id. Change it to switch models.
LLM_MODEL=qwen3.8-max-2026-09-02
DEEPL_API_KEY=
FALLBACK_VOICE_PROFILE_ID=
# Clone model for new voices: qwen-audio-3.1-tts-flash (default) or
# qwen-audio-3.0-tts-flash. System voices always use qwen3-tts-flash.
VOICE_CLONE_MODEL=
# Optional voices for immutable baseline characters. Omit a name to use
# FALLBACK_VOICE_PROFILE_ID. Example: socrates=<uuid>,laozi=<uuid>
BASELINE_DEFAULT_VOICES=
NEXT_PUBLIC_RUNTIME_MODE=
NEXT_PUBLIC_BUILD_SHA=

# Debates (beta) only. With this off, classroom interaction opens after the
# debate finishes, exactly as the classic Debates surface has always required.
# With it on, a teacher can open it while the debate is running, which is what
# puts the join code on the 3D stage and flies messages across it. It also
# means the vote is a running tally rather than a verdict taken once everyone
# has spoken — say so when you report the numbers.
DEBATES_BETA_LIVE_INTERACTION=false

# Opens the fixed-script system-voice preview API only; system voices use
# qwen3-tts-flash either way.
TTS_QWEN3_FLASH_ENABLED=false
