{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maya://schemas/llm_turn_output_v1",
  "title": "LLMTurnOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "speech",
    "key_claims",
    "engagements",
    "answered_required_question",
    "learned_from_others",
    "position_summary",
    "position_update",
    "position_update_reason",
    "remaining_uncertainty",
    "unresolved_issue",
    "question",
    "missing_information",
    "unresolved_questions",
    "change_from_opening",
    "final_consensus",
    "final_disagreements",
    "final_recommendation"
  ],
  "properties": {
    "schema_version": {
      "const": "llm_turn_output_v1"
    },
    "phase": {
      "type": "string",
      "enum": ["opening", "exchange", "final_integration"]
    },
    "speech": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "key_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_text", "claim_type", "used_evidence_refs"],
        "properties": {
          "claim_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "claim_type": {
            "type": "string",
            "enum": ["factual", "interpretation", "value_judgement", "proposal"]
          },
          "used_evidence_refs": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          }
        }
      }
    },
    "engagements": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_turn_ref",
          "target_claim_ref",
          "relation",
          "faithful_summary",
          "response_summary"
        ],
        "properties": {
          "target_turn_ref": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "target_claim_ref": {
            "type": "integer",
            "minimum": -1,
            "maximum": 31,
            "description": "-1 means engage the turn as a whole; non-negative values index that turn's visible claim catalog."
          },
          "relation": {
            "type": "string",
            "enum": ["agree", "extend", "qualify", "challenge", "reconcile"]
          },
          "faithful_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "response_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "answered_required_question": {
      "type": "boolean"
    },
    "learned_from_others": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "position_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "position_update": {
      "type": "string",
      "enum": [
        "unchanged",
        "clarified",
        "extended",
        "qualified",
        "partially_revised",
        "substantially_revised"
      ]
    },
    "position_update_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "remaining_uncertainty": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "unresolved_issue": {
      "type": "string",
      "maxLength": 1200
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target_participant_ref", "text"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "ask"]
        },
        "target_participant_ref": {
          "type": "integer",
          "minimum": -1,
          "maximum": 15,
          "description": "-1 is valid only when mode is none; non-negative values index the allowed question-target catalog."
        },
        "text": {
          "type": "string",
          "maxLength": 1000,
          "description": "Empty only when mode is none; mode ask requires non-empty text."
        }
      }
    },
    "missing_information": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "unresolved_questions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "change_from_opening": {
      "type": "string",
      "maxLength": 1500
    },
    "final_consensus": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "final_disagreements": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "category"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "category": {
            "type": "string",
            "enum": [
              "different_persona_or_framework",
              "different_evidence",
              "evidence_conflict",
              "insufficient_information",
              "value_tradeoff"
            ]
          }
        }
      }
    },
    "final_recommendation": {
      "type": "string",
      "maxLength": 1500
    }
  }
}
